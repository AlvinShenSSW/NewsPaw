{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ · %@" : {
      "comment" : "The suggested name of a GitHub source of Tags or Commits: the repository (owner/name) and the feed's name.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ · latest item %@" : {
      "comment" : "Second line of a declared feed in Add source: the feed format (RSS, Atom, JSON Feed; not translated) and the relative time of its newest item.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · 最新一条 %@"
          }
        }
      }
    },
    "%lld new articles, no overview for today yet" : {
