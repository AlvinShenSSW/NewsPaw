# Copy with `uv run newspaw init`; never commit .env or real credentials.
TELEGRAM_BOT_TOKEN=
# Set a numeric Telegram user ID, OR use the random pairing code generated by init.
TELEGRAM_OWNER_ID=
PAIRING_CODE=

# Optional. Without an API key, RSS search, links and scheduled delivery still work.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional provider endpoint; must support Responses + vision + transcription APIs.
OPENAI_BASE_URL=
TRANSCRIPTION_MODEL=gpt-transcribe

NEWS_TOPICS=国际;日本;澳洲;数码电子
NEWS_LANGUAGE=简体中文
NEWS_FEED_LANGUAGE=zh-CN
NEWS_REGION=US
# Optional additional RSS/Atom feeds separated with semicolons.
NEWS_FEEDS=
SOURCES_FILE=sources.toml
NEWS_MAX_AGE_HOURS=24
DIGEST_SIZE=5
DIGEST_TIMES=09:00,18:00
TIMEZONE=Asia/Tokyo
# Send only the latest missed edition within this window after wake/restart.
CATCHUP_HOURS=6
VOICE_DIGEST=false
# macOS system voice; see `say -v '?'` for installed voices.
MACOS_VOICE=Tingting
# Relative paths resolve against the .env directory.
DATA_DIR=data
