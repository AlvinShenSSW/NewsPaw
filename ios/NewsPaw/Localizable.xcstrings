        }
      }
    },
    "This category has %lld sources. Move them to another category, or delete them with it." : {
      "comment" : "Message of the deletion dialog when the category has sources and another category exists. %lld is the number of sources.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This category has %lld source. Move it to another category, or delete it with the category."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This category has %lld sources. Move them to another category, or delete them with it."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "这个分类有 %lld 个来源。可以把它们移到其他分类，或随分类一起删除。"
                }
              }
            }
          }
        }
      }
    },
    "This category has %lld sources. There is no other category to move them to, so they are deleted with it." : {
      "comment" : "Message of the deletion dialog when the category has sources and is the only category. %lld is the number of sources.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This category has %lld source. There is no other category to move it to, so it is deleted with the category."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This category has %lld sources. There is no other category to move them to, so they are deleted with it."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "这个分类有 %lld 个来源。没有其他分类可以接收，它们会随分类一起删除。"
                }
              }
            }
          }
        }
      }
    },
